# Public Phantom Connect app id from https://phantom.com/portal
# Leave this blank to use the Phantom browser extension only.
# Google and Apple embedded wallets need this public client id.
# Do not put private keys, seed phrases, or API keys in Vite variables.
VITE_PHANTOM_APP_ID=

# Optional Solana devnet RPC URL. It must be a devnet endpoint with no credentials.
# Defaults to https://api.devnet.solana.com
VITE_SOLANA_RPC_URL=
